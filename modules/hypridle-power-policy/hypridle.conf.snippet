general {
    lock_cmd = pidof hyprlock || hyprlock
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch dpms on
    ignore_dbus_inhibit = false
}

# Warn after 9 minutes.
listener {
    timeout = 540
    on-timeout = notify-send "You are idle"
}

# Lock after 10 minutes.
listener {
    timeout = 600
    on-timeout = loginctl lock-session
}

# Turn displays off after lock.
listener {
    timeout = 630
    on-timeout = hyprctl dispatch dpms off
    on-resume = hyprctl dispatch dpms on
}

# Suspend after 20 minutes idle, but only on battery.
listener {
    timeout = 1200
    on-timeout = sh -c 'upower -i /org/freedesktop/UPower/devices/DisplayDevice | grep -q "state:.*discharging" && systemctl suspend'
    on-resume = notify-send "Welcome back"
}
