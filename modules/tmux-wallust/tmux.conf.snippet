# Minimal status line that follows the current wallust/kitty palette.
run-shell '~/.config/tmux/apply-wallust-theme.sh'

# Keep the status line fresh without redrawing every 5 seconds.
set-option -g status-interval 15
set-option -g automatic-rename on

# Use tmux's built-in basename formatter to avoid spawning shell processes.
set-option -g automatic-rename-format '#{b:pane_current_path}'
